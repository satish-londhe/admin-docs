# Google Docs export for DataMount (optional)
# Copy to .env.gdocs — never commit .env.gdocs

# OAuth desktop client JSON (outside repo)
# GOOGLE_OAUTH_KEYS_PATH=~/.config/cmp-docs/gcp-oauth.keys.json

# Saved OAuth token (created by npm run auth:gdocs)
# GOOGLE_TOKEN_PATH=~/.config/cmp-docs/.gdrive-server-credentials.json

# After first sync — reuse same Google Doc on updates
# GOOGLE_DOC_ID=

# Optional — upload new docs into this Drive folder
# GOOGLE_DRIVE_FOLDER_ID=
