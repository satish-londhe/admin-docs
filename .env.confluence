# Confluence Cloud credentials for markfluence (DataMount sync)
# Copy to .env.confluence and fill in — never commit .env.confluence

# e.g. mycompany.atlassian.net (no https://)
CONFLUENCE_DOMAIN=stackconsole.atlassian.net

# Space key from URL: .../wiki/spaces/DATAMOUNT/...
CONFLUENCE_SPACE=DataMount

# Atlassian account email
CONFLUENCE_EMAIL=satish.londhe@stackconsole.io

# API token: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=ATATT3xFfGF0OotlsTGhf2BZHBdkg-IO7galZMl1LwmzyiUZTv7g7NOglwn7gXxFwiXh5RdsaIdHAA2FyFjwW1uU0AUO8iqxI6HlqskC0-28gsatKMoMpAkqiajRh6Di1k89zBJuUfjljItAohlNc6rPBtAlnB4y2A-pF0uNMMbZ9KWDGYwECeI=96CC0B30

# Parent page ID under which DataMount pages are created/updated
# From URL: .../wiki/spaces/SPACE/pages/123456789/Page+Title
CONFLUENCE_PARENT_PAGE_ID=396165401

# Optional: set to true to render Mermaid as PNG (may fail on Gantt charts)
CONFLUENCE_MERMAID=true
